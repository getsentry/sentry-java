      android:value="1.3" />
  </propertyValuesHolder>

  <propertyValuesHolder android:propertyName="scaleY">
    <keyframe
      android:fraction="0"
      android:interpolator="@anim/buddy_ease_smooth"
      android:value="1.3" />
    <keyframe
      android:fraction="0.09"
