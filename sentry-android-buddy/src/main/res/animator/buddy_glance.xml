<?xml version="1.0" encoding="utf-8"?>
<!-- bd-glance: the pupil looks left, then right, then re-centres. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="4500"
    android:repeatCount="infinite"
    android:valueType="floatType">
    <propertyValuesHolder android:propertyName="translateX">
        <keyframe android:fraction="0" android:value="0" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="0.06" android:value="-1.7" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="0.34" android:value="-1.7" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="0.46" android:value="1.7" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="0.8" android:value="1.7" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="0.92" android:value="0" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="1" android:value="0" android:interpolator="@anim/buddy_ease_out" />
    </propertyValuesHolder>
    <propertyValuesHolder android:propertyName="translateY">
        <keyframe android:fraction="0" android:value="0" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="0.06" android:value="0.2" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="0.34" android:value="0.2" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="0.46" android:value="0.2" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="0.8" android:value="0.2" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="0.92" android:value="0" android:interpolator="@anim/buddy_ease_out" />
        <keyframe android:fraction="1" android:value="0" android:interpolator="@anim/buddy_ease_out" />
    </propertyValuesHolder>
</objectAnimator>
