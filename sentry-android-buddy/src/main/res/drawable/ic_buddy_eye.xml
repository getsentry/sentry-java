<?xml version="1.0" encoding="utf-8"?>
<!-- Base Seer eye on an accent bubble. No beam.
     Shapes are now open, stroked outlines instead of solid filled silhouettes,
     so the icon can sit on a fully opaque background without needing a
     knockout/cutout shape for the eye. The pupil is drawn twice at partial
     alpha (pupil_dot + pupil_dot_soft) to build up a soft, layered look. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
  android:width="44dp"
  android:height="44dp"
  android:viewportWidth="26"
  android:viewportHeight="26">

  <path
    android:name="head"
    android:fillColor="#00000000"
    android:strokeColor="@color/buddy_on_vibrant"
    android:strokeWidth="1.45127"
    android:strokeLineCap="round"
    android:strokeLineJoin="round"
    android:pathData="M 5.7025148,17.691391 C 6.4745801,15.188369 9.506173,9.7767653 13.000011,6.0200714 c 4.466671,4.9954836 6.592334,9.3621586 7.297496,11.6630026 -3.16938,1.264081 -8.43907,2.708335 -14.5949922,0.0083 z" />

  <group
    android:name="eye"
    android:pivotX="13"
    android:pivotY="14.6">
    <path
      android:name="eyeball"
      android:strokeColor="@color/buddy_on_vibrant"
      android:strokeWidth="1.45127"
      android:strokeLineCap="round"
      android:pathData="M 7.0824898,14.7623 C 7.0824898,14.7623 13.374241,17.101241 18.847364,14.69213 C 16.672148,8.5173174 10.052945,7.6285196 7.0824898,14.7623 Z" />
    <group
      android:name="pupil"
      android:pivotX="13"
      android:pivotY="14">
      <path
        android:name="pupil_dot"
        android:fillColor="@color/buddy_on_vibrant"
        android:fillAlpha="0.5393053"
        android:pathData="m 12.972109,14.357596 m -2,0 a 2,2 0 1,0 4,0 2,2 0 1,0 -4,0" />
      <path
        android:name="pupil_dot_soft"
        android:fillColor="@color/buddy_on_vibrant"
        android:fillAlpha="0.38391225"
        android:pathData="m 12.965488,14.403498 m -2,0 a 2,2 0 1,0 4,0 2,2 0 1,0 -4,0" />
    </group>
  </group>

</vector>
