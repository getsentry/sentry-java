<?xml version="1.0" encoding="utf-8"?>
<!-- Chonk ledge: solid 2dp lip under the face, per the Scraps button spec. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/buddy_border" />
        </shape>
    </item>
    <item android:bottom="@dimen/buddy_chonk_ledge">
        <shape android:shape="oval">
            <solid android:color="@color/buddy_surface" />
                <stroke android:width="1dp" android:color="@color/buddy_border" />
        </shape>
    </item>
</layer-list>
